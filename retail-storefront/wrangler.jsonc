{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retail-storefront",
  "compatibility_date": "2026-06-30",
  // Static export: serve the prebuilt ./out directory as plain assets.
  // No Worker script — keeps wrangler from invoking the OpenNext server
  // adapter, which is incompatible with `output: "export"`.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
